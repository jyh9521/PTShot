{
  "name": "ptshot",
  "productName": "PTShot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Mosaic screenshots, lossless PNG optimization and Pixhost uploads in Material 3 Expressive.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "playwright test",
    "test:desktop": "node scripts/desktop_smoke.mjs",
    "package:win": "npm run build && node scripts/package_windows.mjs"
  },
  "dependencies": {
    "@kyralabs/m3e-css": "1.8.0",
    "@kyralabs/m3e-react": "1.8.0",
    "@kyralabs/m3e-tokens": "1.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "45.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
